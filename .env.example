# 搜索API配置
# 可选引擎: serpapi | valueserp | serper（当前使用 serper）
# SEARCH_ENGINE=serper

# SerpAPI 密钥（搜索引擎为 serpapi 时必填）
SERPAPI_KEY=your_serpapi_key_here

# ValueSERP 密钥（搜索引擎为 valueserp 时必填）
# VALUESERP_KEY=your_valueserp_key_here

# Serper 密钥（当前搜索引擎，搜索引擎为 serper 时必填，https://serper.dev）
# SERPER_KEY=your_serper_key_here

# Amazon Scraper API 密钥（https://amazonscraperapi.com）
# ASA_KEY=your_asa_key_here

# eBay Browse API 凭证
# EBAY_APP_ID=your_ebay_app_id_here
# EBAY_CERT_ID=your_ebay_cert_id_here

# Google OAuth（可选）
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
