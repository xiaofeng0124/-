# 搜索API配置
# 可选引擎: serpapi（默认）| valueserp | serper
# SEARCH_ENGINE=serpapi

# SerpAPI 密钥（搜索引擎为 serpapi 时必填）
SERPAPI_KEY=your_serpapi_key_here

# ValueSERP 密钥（搜索引擎为 valueserp 时必填）
# VALUESERP_KEY=your_valueserp_key_here

# Serper 密钥（搜索引擎为 serper 时必填，https://serper.dev）
# SERPER_KEY=your_serper_key_here
